<UserControl x:Class="TimerAlarmPlugin.SettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="{DynamicResource SettingPanelMargin}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Text="Stop ringing after (seconds)"
                   VerticalAlignment="Center"/>

        <TextBox Grid.Column="1"
                 Width="150"
                 Text="{Binding StopRingingAfter, UpdateSourceTrigger=PropertyChanged}"
                 VerticalContentAlignment="Center"/>
    </Grid>
</UserControl>